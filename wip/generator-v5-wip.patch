+    if lo + ln > along0 + along_len:
+        lo = along0 + along_len - ln
+    if beside:
+        nx = x if ox + ow == x else x + w - d
+        return nx, lo, d, ln
+    ny = y if oy + oh == y else y + h - d
+    return lo, ny, ln, d
