+    along_lo, along_hi, along0, along_len, depth_len = (oy, oy + oh, y, h, w) if beside else (ox, ox + ow, x, w, h)
+    sq = int(math.sqrt(cap))
+    d = min(depth_len, max(side, sq))
+    ln = min(along_len, max(side, cap // max(d, 1)))
+    if d * ln > cap:
